               <rdf:li xml:lang="x-default">BMC Medical Research Methodology, 2021, doi:10.1186/s12874-021-01280-3</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Survival analysis</rdf:li>
               <rdf:li>Time-to-event</rdf:li>
               <rdf:li>Tuberculosis</rdf:li>
               <rdf:li>Systematic review</rdf:li>
               <rdf:li>Africa</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A systematic review of the quality of conduct and reporting of survival analyses of tuberculosis outcomes in Africa</rdf:li>
            </rdf:Alt>
         </dc:title>
